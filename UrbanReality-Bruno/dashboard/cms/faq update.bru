meta {
  name: faq update
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/admin/cms/edit
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  faq.pageTitle.en: How It Worked
  faq.pageTitle.ar: كيف يعمل
  type: 2
  faq.description.en: descriptionen
  faq.description.ar: descriptionen
}

settings {
  encodeUrl: true
  timeout: 0
}
